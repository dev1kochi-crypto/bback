NEXT_PUBLIC_API_BASE_URL=https://bback.mightywarnersdemo.com
# Public frontend URL used for canonical/meta tags (set to your Vercel domain in production)
NEXT_PUBLIC_SITE_URL=https://bback-topaz.vercel.app/

# Shared secret used by Laravel CMS to purge cached frontend pages immediately after content changes.
# Must match FRONTEND_REVALIDATE_SECRET in the Laravel .env file.
REVALIDATE_SECRET=bback-revalidate-8f3k2m9x7p1q

# Fallback cache window (seconds) when on-demand revalidation is unavailable.
CMS_REVALIDATE_SECONDS=10
